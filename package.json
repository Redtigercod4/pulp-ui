{
	"name": "pulp-ui",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"author": "Pulp",
	"contributors": [
		"Martin Hradil",
		"Zita Pospisil Nemeckova",
		"Redtigercod4"
	],
	"private": true,
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.23.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24.15.0",
		"npm": ">=11.29.0"
	},
	"scripts": {
		"preview": "vite preview",
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"test:unit": "vitest --tags-filter=unit",
		"test:integration": "vitest --tags-filter=integration",
		"test:component": "vitest --tags-filter=component",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@pulp/sdk": "workspace:",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"@tanstack/react-router": "1.170.32"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"jsdom": "30.0.1",
		"msw": "catalog:",
		"@lingui/swc-plugin": "6.6.0",
		"@lingui/vite-plugin": "6.6.0",
		"@tanstack/router-plugin": "1.168.33",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "catalog:",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitest/coverage-v8": "catalog:",
		"@vitejs/plugin-react-swc": "4.3.3",
		"typescript": "catalog:",
		"vite": "8.2.2",
		"vitest": "catalog:"
	}
}
