{
	"name": "pulp-ui",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"author": "Pulp",
	"contributors": [
		"Martin Hradil",
		"Zita Pospisil Nemeckova",
		"Redtigercod4"
	],
	"private": true,
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.23.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"scripts": {
		"preview": "vite preview",
		"dev": "vite",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@pulp/sdk": "workspace:",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"@tanstack/react-router": "1.170.32"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@lingui/swc-plugin": "6.6.0",
		"@lingui/vite-plugin": "6.6.0",
		"@tanstack/router-plugin": "1.168.33",
		"@types/node": "catalog:",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react-swc": "4.3.3",
		"typescript": "catalog:",
		"vite": "8.2.2"
	}
}
